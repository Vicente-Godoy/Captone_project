rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    function isMatchParticipant(matchId) {
      return matchExists(matchId) &&
        request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId) {
      return conversationExists(conversationId) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /calendarEvents/{eventId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /availability/{slotId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    match /publications/{publicationId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && request.auth.uid == resource.data.creatorId;
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.fromUid;
      allow update: if false;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.fromUid;
    }

    match /matches/{matchId} {
      allow read, update, delete: if isMatchParticipant(matchId);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['users'])
        && request.resource.data.users.size() > 0
        && request.auth.uid in request.resource.data.users;

      match /calendarEvents/{eventId} {
        allow read, write, delete: if isMatchParticipant(matchId);
      }
    }

    match /conversations/{conversationId} {
      allow read, update: if isConversationParticipant(conversationId);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['participants'])
        && request.resource.data.participants.size() > 0
        && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if isConversationParticipant(conversationId);
        allow delete, update: if false;
      }
    }

    match /token_blacklist/{tokenId} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
